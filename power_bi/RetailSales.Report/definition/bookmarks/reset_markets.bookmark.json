{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/2.1.0/schema.json",
  "name": "reset_markets",
  "displayName": "Reset markets",
  "explorationState": {
    "version": "1.0",
    "activeSection": "markets",
    "sections": {
      "markets": {
        "visualContainers": {
          "markets_month": {
            "singleVisual": {
              "objects": {
                "merge": {
                  "general": [
                    {
                      "properties": {
                        "selfFilterEnabled": {
                          "expr": {
                            "Literal": {
                              "Value": "true"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "markets_country": {
            "singleVisual": {
              "objects": {
                "merge": {
                  "general": [
                    {
                      "properties": {
                        "selfFilterEnabled": {
                          "expr": {
                            "Literal": {
                              "Value": "true"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "markets_segment": {
            "singleVisual": {
              "objects": {
                "merge": {
                  "general": [
                    {
                      "properties": {
                        "selfFilterEnabled": {
                          "expr": {
                            "Literal": {
                              "Value": "true"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "options": {
    "targetVisualNames": [
      "markets_month",
      "markets_country",
      "markets_segment"
    ],
    "applyOnlyToTargetVisuals": true,
    "suppressDisplay": true,
    "suppressActiveSection": true
  }
}