        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(ProjectFolder & \"/data/processed/cleaned_retail.csv\"), [Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Selected = Table.SelectColumns(Headers,{\"SourceRow\",\"Invoice\",\"StockCode\",\"CustomerID\",\"Country\",\"InvoiceDay\",\"Hour\",\"Quantity\",\"RevenuePence\"}),",
                " Blanks = Table.ReplaceValue(Selected,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Selected)),",
                " Typed = Table.TransformColumnTypes(Blanks,{{\"SourceRow\",Int64.Type},{\"Invoice\",type text},{\"StockCode\",type text},{\"CustomerID\",type text},{\"Country\",type text},{\"InvoiceDay\",type datetime},{\"Hour\",Int64.Type},{\"Quantity\",Int64.Type},{\"RevenuePence\",Int64.Type}},\"en-GB\")",
                "in",
                " Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Customers",
        "columns": [
          {
            "name": "CustomerID",
            "dataType": "string",
            "isHidden": true,
            "isKey": true,
            "lineageTag": "7e511fa7-ef61-4779-ac0c-65191056f0e2",
            "sourceColumn": "CustomerID",
            "summarizeBy": "none"
          },
          {
            "name": "Recency",
