            "name": "Selection note",
            "description": "Dynamic scope of the current selection.",
            "displayFolder": "Context",
            "expression": "\"Identified customers · GBP · positive sales · \" & [Selected period]",
            "lineageTag": "9fc8fd95-8a49-4141-91f8-f265fea13a2d"
