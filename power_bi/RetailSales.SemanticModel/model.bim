            "expression": "DIVIDE(SUM(Sales[RevenuePence]),100)",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "c687bd55-7a97-46bb-ade2-ec13bd6b9b34"
          },
          {
            "name": "Orders",
            "description": "Distinct invoices in the current selection; counts are non-additive across groups.",
            "displayFolder": "Sales",
            "expression": "DISTINCTCOUNT(Sales[Invoice])",
            "formatString": "#,##0",
            "lineageTag": "57569c52-dfb0-4d3e-ac84-6e146c914b3a"
          },
          {
            "name": "Customers",
            "description": "Distinct identified customers with eligible lines in the current selection.",
            "displayFolder": "Sales",
            "expression": "DISTINCTCOUNT(Sales[CustomerID])",
            "formatString": "#,##0",
            "lineageTag": "b701e879-24ee-473d-8eae-f30e6ffd7446"
          },
          {
            "name": "Products",
            "description": "Distinct stock codes, including retained non-merchandise codes.",
            "displayFolder": "Sales",
            "expression": "DISTINCTCOUNT(Sales[StockCode])",
            "formatString": "#,##0",
            "lineageTag": "5a9f80a1-3a3f-4fb4-b18a-55cba24c4af9"
          },
          {
            "name": "Units",
            "description": "Eligible positive units.",
            "displayFolder": "Sales",
            "expression": "SUM(Sales[Quantity])",
            "formatString": "#,##0",
            "lineageTag": "64a01037-4367-48b0-8eae-aae126727f3d"
          },
          {
            "name": "Sales lines",
            "description": "Eligible source invoice lines.",
            "displayFolder": "Sales",
            "expression": "COUNTROWS(Sales)",
            "formatString": "#,##0",
            "lineageTag": "5b679119-740c-4bb2-b41c-ffdbb4cb08ef"
          },
          {
            "name": "Average order value",
            "description": "Selected sales divided by distinct invoices. Product selection gives selected-product sales per containing invoice.",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Positive sales],[Orders])",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "d650b88f-811c-4873-99d7-8e29887c2523"
          },
          {
            "name": "Sales per customer",
            "description": "Observed selected sales per active customer; not predictive lifetime value.",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Positive sales],[Customers])",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "7a9eda82-9cd7-4c84-89c4-7bf82dfdd2ed"
          },
          {
            "name": "Repeat customers",
            "description": "Customers with more than one distinct invoice in the current selection.",
            "displayFolder": "Customers",
            "expression": "COUNTROWS(FILTER(VALUES(Sales[CustomerID]),CALCULATE([Orders])>1))",
            "formatString": "#,##0",
            "lineageTag": "d6223b2e-d91a-4b0b-803d-636c49d1ff0b"
          },
          {
            "name": "Repeat customer rate",
            "description": "Repeat customers / customers, both in the current selection.",
            "displayFolder": "Customers",
            "expression": "DIVIDE([Repeat customers],[Customers])",
            "formatString": "0.00%",
            "lineageTag": "6ce7aa27-8ec7-45fc-a3f9-4ca60c1613cd"
          },
          {
            "name": "Single-order customers",
            "description": "One order in the current selection; not necessarily new customers.",
            "displayFolder": "Customers",
            "expression": "[Customers]-[Repeat customers]",
            "formatString": "#,##0",
            "lineageTag": "0960bc43-08cc-42de-b26c-2300a63b5d1e"
          },
          {
            "name": "Country sales share",
            "description": "Sales share of selected countries, retaining other filters.",
            "displayFolder": "Sales",
            "expression": "DIVIDE([Positive sales],CALCULATE([Positive sales],ALLSELECTED(Countries[Country])))",
            "formatString": "0.00%",
            "lineageTag": "59a2e461-dc92-4dc5-92d8-1d7a9f543215"
          },
          {
            "name": "Full-month sales",
            "description": "Only one fully observed, fully selected calendar month.",
            "displayFolder": "Time",
            "expression": "VAR DaysInMonth=DAY(EOMONTH(MAX('Calendar'[Date]),0)) RETURN IF(HASONEVALUE('Calendar'[YearMonth]) && SELECTEDVALUE('Calendar'[IsFullMonth])=TRUE() && COUNTROWS(VALUES('Calendar'[Date]))=DaysInMonth,[Positive sales])",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "d82e2183-2b79-4ce2-a407-3df6eeae97a9"
          },
          {
            "name": "Previous full-month sales",
            "description": "Previous complete calendar month.",
            "displayFolder": "Time",
            "expression": "CALCULATE([Full-month sales],DATEADD('Calendar'[Date],-1,MONTH))",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "14d50b7f-9cb4-4558-9e3b-854ed7281efd"
          },
          {
            "name": "MoM growth",
            "description": "Blank for partial months or unavailable/zero comparisons.",
            "displayFolder": "Time",
            "expression": "VAR C=[Full-month sales] VAR P=[Previous full-month sales] RETURN IF(NOT ISBLANK(C) && NOT ISBLANK(P),DIVIDE(C-P,P))",
            "formatString": "0.00%",
            "lineageTag": "ef6edc58-29ed-49b2-aa9a-1d282ee8336a"
          },
          {
            "name": "Prior-year full-month sales",
            "description": "Matching complete month one year earlier.",
            "displayFolder": "Time",
            "expression": "CALCULATE([Full-month sales],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "134322b1-544c-4783-9ffb-a3fe729310d5"
          },
          {
            "name": "YoY growth",
            "description": "Full-month year-over-year comparison only.",
            "displayFolder": "Time",
            "expression": "VAR C=[Full-month sales] VAR P=[Prior-year full-month sales] RETURN IF(NOT ISBLANK(C) && NOT ISBLANK(P),DIVIDE(C-P,P))",
            "formatString": "0.00%",
            "lineageTag": "0f17dc97-ce04-4f8d-98ff-4bfafa54d4a0"
          },
          {
            "name": "Complete-month sales",
            "description": "Complete-month portion for the trend chart.",
            "displayFolder": "Time",
            "expression": "CALCULATE([Positive sales],KEEPFILTERS('Calendar'[IsFullMonth]=TRUE()))",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "7b34b2cc-5d9e-42fc-83f1-7bfe33636736"
          },
          {
            "name": "Partial-month sales",
            "description": "Partial observed months are displayed separately in amber.",
            "displayFolder": "Time",
            "expression": "CALCULATE([Positive sales],KEEPFILTERS('Calendar'[IsFullMonth]=FALSE()))",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "2c1a054c-304f-4367-b105-be22ed1d5d43"
          },
          {
            "name": "Product rank",
            "description": "Rank within selected stock codes; descriptions use latest observed source label.",
            "displayFolder": "Sales",
            "expression": "RANKX(ALLSELECTED(Products),[Positive sales],,DESC,DENSE)",
            "formatString": "#,##0",
            "lineageTag": "a40852a2-a2e8-442d-b0ca-22fde90273f3"
          },
          {
            "name": "Top 10 product sales",
            "description": "Top ten ranks within the selection; ties can produce more than ten products.",
            "displayFolder": "Sales",
            "expression": "IF([Product rank]<=10,[Positive sales])",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "b2641b7b-ced7-42b4-88a2-799847d5bd5c"
          },
          {
            "name": "Country rank",
            "description": "Rank within selected countries.",
            "displayFolder": "Sales",
            "expression": "RANKX(ALLSELECTED(Countries[Country]),[Positive sales],,DESC,DENSE)",
            "formatString": "#,##0",
            "lineageTag": "14636bba-1c2f-4cad-a2d7-80cea335e89f"
          },
          {
            "name": "Top 10 country sales",
            "description": "Top ten country ranks within the current selection.",
            "displayFolder": "Sales",
            "expression": "IF([Country rank]<=10,[Positive sales])",
            "formatString": "£#,##0.00;(£#,##0.00);£0.00",
            "lineageTag": "6a72b154-8ac3-45c0-9d4f-caf2a2e5fb80"
          },
          {
            "name": "Cohort retention",
            "description": "Fixed full-history cohort snapshot. Future cells are blank; original cohort denominator is fixed.",
            "displayFolder": "Cohort snapshot",
            "expression": "IF(HASONEVALUE(Cohorts[CohortMonth]) && HASONEVALUE(Cohorts[MonthIndex]),DIVIDE(SUM(Cohorts[ActiveCustomers]),MAX(Cohorts[CohortSize])))",
            "formatString": "0.0%",
            "lineageTag": "56a0be51-729a-44e9-9ed8-c8c9101fceb1"
          },
          {
            "name": "Cohort customers",
            "description": "Original customers in selected first-observed purchase cohorts.",
            "displayFolder": "Cohort snapshot",
            "expression": "SUMX(VALUES(Cohorts[CohortMonth]),CALCULATE(MAX(Cohorts[CohortSize])))",
            "formatString": "#,##0",
            "lineageTag": "ba14c8d6-d8f3-406b-a2bf-f5c7bbdafb99"
          },
          {
            "name": "Cohort month count",
            "description": "Selected first-observed purchase cohort months.",
            "displayFolder": "Cohort snapshot",
            "expression": "DISTINCTCOUNT(Cohorts[CohortMonth])",
            "formatString": "#,##0",
            "lineageTag": "086bc491-ae2b-44c1-9321-bf396c237d02"
          },
          {
            "name": "Excluded lines",
            "description": "Mutually exclusive excluded source rows; fixed population audit.",
            "displayFolder": "Source audit",
            "expression": "SUM(Quality[Rows])",
            "formatString": "#,##0",
            "lineageTag": "a6e6fa12-48a4-456f-85e8-98d74c8aec50"
          },
          {
            "name": "Source lines",
            "description": "Unfiltered raw input row count.",
            "displayFolder": "Source audit",
            "expression": "MAX(Audit[SourceRows])",
            "formatString": "#,##0",
            "lineageTag": "044ec13f-2a46-4448-9094-25f169a6c938"
          },
          {
            "name": "Eligible lines audit",
            "description": "Unfiltered retained population count.",
            "displayFolder": "Source audit",
            "expression": "MAX(Audit[EligibleRows])",
            "formatString": "#,##0",
            "lineageTag": "ef25a789-3fa1-48c6-bae8-a33b3e411aef"
          },
          {
            "name": "Retained line rate",
            "description": "Eligible invoice lines / input invoice lines; not a sales-value share.",
            "displayFolder": "Source audit",
            "expression": "DIVIDE([Eligible lines audit],[Source lines])",
            "formatString": "0.00%",
            "lineageTag": "794fb852-6a0e-40ce-9f20-c53f7d3bd2af"
          },
          {
            "name": "Selected period",
            "description": "Observed dates of eligible sales in the current selection.",
            "displayFolder": "Context",
            "expression": "VAR A=MIN(Sales[InvoiceDay]) VAR B=MAX(Sales[InvoiceDay]) RETURN IF(ISBLANK(A),\"No eligible sales in this selection\",FORMAT(A,\"dd MMM yyyy\") & \" – \" & FORMAT(B,\"dd MMM yyyy\"))",
            "lineageTag": "49dfbf47-82b0-4058-bbf9-1a6df67899f7"
          },
